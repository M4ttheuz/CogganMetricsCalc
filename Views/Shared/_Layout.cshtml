<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VeloAnalytics</title>

    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-light text-dark">
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-controller="Activity" asp-action="Index">
                    <i class="bi bi-activity text-primary fs-4"></i>
                    <span>VeloAnalytics</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link py-2 px-3 rounded" asp-controller="Activity" asp-action="All">
                                <i class="bi bi-list-ul me-1"></i> Aktywności
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link py-2 px-3 rounded" asp-controller="Pmc" asp-action="Index">
                                <i class="bi bi-graph-up-arrow me-1"></i> Wykres Formy (PMC)
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link py-2 px-3 rounded" asp-controller="Profile" asp-action="Index">
                                <i class="bi bi-person-gear me-1"></i> Profil zawodnika
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link py-2 px-3 rounded" asp-controller="Activity" asp-action="Upload">
                                <i class="bi bi-cloud-upload me-1"></i> Import FIT
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link py-2 px-3 rounded" asp-controller="Activity" asp-action="Phenotype">
                                <i class="bi bi-person-badge me-1"></i> Fenotyp
                            </a>
                        </li>
                    </ul>
                    <ul class="navbar-nav ms-auto align-items-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <span class="text-light small opacity-75">
                                    <i class="bi bi-person-circle me-1"></i> @User.Identity.Name
                                </span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-light">Wyloguj</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Logowanie</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-sm btn-primary" asp-controller="Account" asp-action="Register">Rejestracja</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container py-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer mt-auto py-3 bg-white border-top">
        <div class="container text-center text-muted small">
            &copy; 2026 <strong>VeloAnalytics</strong> – System Analizy Wydolności Kolarskiej opartej na modelu Coggana
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>