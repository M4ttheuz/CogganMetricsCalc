@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    string IsActive(string controller, string? action = null)
    {
        bool controllerMatch = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);
        bool actionMatch = action == null || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
        return (controllerMatch && actionMatch) ? "active" : "";
    }
}
<!DOCTYPE html>
<html lang="pl" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VeloAnalytics</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark navbar-velo">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2 me-4" asp-controller="Activity" asp-action="Index">
                    <span class="brand-icon-box">
                        <i class="bi bi-activity"></i>
                    </span>
                    <span class="tracking-tight">Velo<span class="text-info">Analytics</span></span>
                </a>
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1">
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 rounded-3 @IsActive("Activity", "Index")" asp-controller="Activity" asp-action="Index">
                                <i class="bi bi-speedometer2 me-1"></i> Pulpit
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 rounded-3 @IsActive("Activity", "All")" asp-controller="Activity" asp-action="All">
                                <i class="bi bi-list-ul me-1"></i> Aktywności
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 rounded-3 @IsActive("Pmc")" asp-controller="Pmc" asp-action="Index">
                                <i class="bi bi-graph-up-arrow me-1"></i> Forma (PMC)
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 rounded-3 @IsActive("Activity", "Phenotype")" asp-controller="Activity" asp-action="Phenotype">
                                <i class="bi bi-diagram-3 me-1"></i> Fenotyp
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 rounded-3 @IsActive("Profile")" asp-controller="Profile" asp-action="Index">
                                <i class="bi bi-person me-1"></i> Profil
                            </a>
                        </li>
                        <li class="nav-item ms-lg-2">
                            <a class="nav-link nav-link-upload px-3 py-2 rounded-3 @IsActive("Activity", "Upload")" asp-controller="Activity" asp-action="Upload">
                                <i class="bi bi-cloud-arrow-up-fill me-1"></i> Import FIT
                            </a>
                        </li>
                    </ul>
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-2 pt-2 pt-lg-0 border-top border-lg-0 border-subtle">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <span class="user-pill">
                                    <i class="bi bi-person-circle text-info me-1"></i> @User.Identity.Name
                                </span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-logout">
                                        <i class="bi bi-box-arrow-right me-1"></i> Wyloguj
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3" asp-controller="Account" asp-action="Login">Logowanie</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-sm btn-info fw-semibold text-dark px-3 py-2 rounded-3" asp-controller="Account" asp-action="Register">Rejestracja</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container py-4 flex-grow-1">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer mt-auto py-3 footer-velo">
        <div class="container d-flex flex-column flex-sm-row justify-content-between align-items-center text-muted small gap-2">
            <div>
                &copy; 2026 <strong class="text-white">VeloAnalytics</strong> – Analiza wydolności kolarskiej opartej na modelu Coggana
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25">TSS / CTL / ATL</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>