@model inzynierka.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Logowanie";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5 col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <i class="bi bi-activity text-primary auth-icon"></i>
                    <h4 class="fw-bold mt-2">Logowanie</h4>
                    <p class="text-muted small">Wpisz dane, aby wejść do VeloAnalytics</p>
                </div>

                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Adres e-mail</label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-semibold">Hasło</label>
                        <input asp-for="Password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">Zaloguj się</button>
                </form>

                <div class="text-center mt-3">
                    <span class="small text-muted">Nie masz jeszcze konta? </span>
                    <a asp-action="Register" class="small fw-semibold text-decoration-none">Utwórz konto</a>
                </div>
            </div>
        </div>
    </div>
</div>