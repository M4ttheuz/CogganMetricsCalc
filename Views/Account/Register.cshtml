@model inzynierka.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Rejestracja";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <i class="bi bi-bicycle text-primary" style="font-size: 2.5rem;"></i>
                    <h4 class="fw-bold mt-2">Utwórz konto</h4>
                    <p class="text-muted small">Skonfiguruj profil i analizuj swoje treningi</p>
                </div>

                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Adres e-mail</label>
                        <input asp-for="Email" class="form-control"/>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Masa ciała (kg)</label>
                            <input asp-for="WeightKg" type="number" step="0.5" class="form-control"/>
                            <span asp-validation-for="WeightKg" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Początkowe FTP (W)</label>
                            <input asp-for="InitialFtp" type="number" class="form-control"/>
                            <span asp-validation-for="InitialFtp" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Hasło</label>
                        <input asp-for="Password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-semibold">Powtórz hasło</label>
                        <input asp-for="ConfirmPassword" class="form-control" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">Zarejestruj się</button>
                </form>

                <div class="text-center mt-3">
                    <span class="small text-muted">Masz już konto? </span>
                    <a asp-action="Login" class="small fw-semibold text-decoration-none">Zaloguj się</a>
                </div>
            </div>
        </div>
    </div>
</div>