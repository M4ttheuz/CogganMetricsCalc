@model List<inzynierka.Models.Entities.Activity>
@{
    ViewData["Title"] = "Wszystkie aktywności";
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    int totalCount = ViewBag.TotalCount;
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">Historia treningów</h3>
            <p class="text-muted small mb-0">Łącznie zarejestrowano: <strong>@totalCount</strong> sesji</p>
        </div>
        <a asp-action="Upload" class="btn btn-primary fw-semibold">
            <i class="bi bi-plus-circle me-1"></i> Importuj pliki FIT
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm p-5 text-center text-muted">
            <i class="bi bi-inbox fs-1 mb-2"></i>
            Brak treningów w bazie.
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="small text-muted text-uppercase">
                            <th>Data</th>
                            <th>Nazwa sesji</th>
                            <th>Czas</th>
                            <th>Dystans</th>
                            <th>NP</th>
                            <th>IF</th>
                            <th>TSS</th>
                            <th class="text-end">Szczegóły</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var act in Model)
                        {
                            <tr>
                                <td class="text-nowrap small text-muted">
                                    @act.StartTime.ToString("dd.MM.yyyy HH:mm")
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@act.Id" class="text-decoration-none fw-semibold text-dark">
                                        @act.Title
                                    </a>
                                </td>
                                <td class="text-nowrap small">
                                    @TimeSpan.FromSeconds(act.DurationSeconds).ToString(@"hh\:mm\:ss")
                                </td>
                                <td class="text-nowrap small">
                                    @(Math.Round(act.DistanceMeters / 1000m, 1)) km
                                </td>
                                <td class="fw-bold text-primary small">
                                    @(act.CogganMetrics?.NormalizedPower != null ? $"{act.CogganMetrics.NormalizedPower} W" : "—")
                                </td>
                                <td class="small">
                                    @(act.CogganMetrics?.IntensityFactor?.ToString("F2") ?? "—")
                                </td>
                                <td class="fw-bold text-danger small">
                                    @(act.CogganMetrics?.TrainingStressScore?.ToString("F0") ?? "—")
                                </td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@act.Id" class="btn btn-sm btn-outline-primary">
                                        Otwórz &rarr;
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Paginacja -->
        @if (totalPages > 1)
        {
            <nav>
                <ul class="pagination justify-content-center">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="All" asp-route-page="@(currentPage - 1)">Poprzednia</a>
                    </li>
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" asp-action="All" asp-route-page="@i">@i</a>
                        </li>
                    }
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="All" asp-route-page="@(currentPage + 1)">Następna</a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>