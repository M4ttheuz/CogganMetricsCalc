@model List<inzynierka.Models.Entities.Activity>
@{
    ViewData["Title"] = "Wszystkie aktywności";
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    int totalCount = ViewBag.TotalCount;
}

<div class="container-fluid px-0 py-2">
    <!-- NAGŁÓWEK -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h4 class="fw-bold text-white mb-1 d-flex align-items-center">
                <i class="bi bi-list-ul text-info me-2"></i>Historia treningów
            </h4>
            <p class="text-muted small mb-0">Łącznie zarejestrowano w bazie: <strong class="text-white">@totalCount</strong> sesji</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            @if (totalCount > 0)
            {
                <form asp-action="DeleteAll" method="post" class="d-inline" 
                      onsubmit="return confirm('UWAGA: Czy na pewno chcesz bezpowrotnie usunąć WSZYSTKIE jednostki treningowe? Wykres formy zostanie zresetowany.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-danger fw-semibold px-3 py-2">
                        <i class="bi bi-trash3 me-1"></i> Usuń wszystko
                    </button>
                </form>
            }
            <a asp-action="Upload" class="btn btn-sm btn-info text-dark fw-semibold px-3 py-2">
                <i class="bi bi-cloud-arrow-up-fill me-1"></i> Importuj pliki FIT
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card p-5 text-center text-muted">
            <i class="bi bi-inbox fs-1 mb-3 opacity-50"></i>
            <p class="mb-0">Brak treningów w bazie.</p>
            <small>Użyj przycisku importu powyżej, aby dodać pierwsze pliki .fit.</small>
        </div>
    }
    else
    {
        <div class="card mb-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr class="small text-muted text-uppercase" style="letter-spacing: 0.05em;">
                            <th class="ps-3 py-3">Data</th>
                            <th class="py-3">Nazwa sesji</th>
                            <th class="py-3">Czas</th>
                            <th class="py-3">Dystans</th>
                            <th class="py-3">NP</th>
                            <th class="py-3">IF</th>
                            <th class="py-3">TSS</th>
                            <th class="text-end pe-3 py-3">Akcje</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var act in Model)
                        {
                            <tr>
                                <td class="text-nowrap small text-muted ps-3 tabular-nums">
                                    @act.StartTime.ToString("dd.MM.yyyy HH:mm")
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@act.Id" class="text-decoration-none fw-semibold text-white">
                                        @act.Title
                                    </a>
                                </td>
                                <td class="text-nowrap small text-muted tabular-nums">
                                    @TimeSpan.FromSeconds(act.DurationSeconds).ToString(@"hh\:mm\:ss")
                                </td>
                                <td class="text-nowrap small text-muted tabular-nums">
                                    @(Math.Round(act.DistanceMeters / 1000m, 1)) km
                                </td>
                                <td class="fw-bold text-info small tabular-nums">
                                    @(act.CogganMetrics?.NormalizedPower != null ? $"{act.CogganMetrics.NormalizedPower} W" : "—")
                                </td>
                                <td class="small text-white tabular-nums">
                                    @(act.CogganMetrics?.IntensityFactor?.ToString("F2") ?? "—")
                                </td>
                                <td class="fw-bold text-danger small tabular-nums">
                                    @(act.CogganMetrics?.TrainingStressScore?.ToString("F0") ?? "—")
                                </td>
                                <td class="text-end text-nowrap pe-3">
                                    <a asp-action="Details" asp-route-id="@act.Id" class="btn btn-sm btn-outline-info me-1 py-1 px-2" title="Szczegóły sesji">
                                        Otwórz →
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@act.Id" method="post" class="d-inline" onsubmit="return confirm('Czy na pewno chcesz usunąć tę sesję? Wszystkie powiązane metryki i wykresy PMC zostaną przeliczone.');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-2" title="Usuń trening">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (totalPages > 1)
        {
            <nav aria-label="Nawigacja stron">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link bg-dark border-subtle text-white" asp-action="All" asp-route-page="@(currentPage - 1)">
                            <i class="bi bi-chevron-left me-1"></i> Poprzednia
                        </a>
                    </li>
                    <li class="page-item disabled">
                        <span class="page-link bg-dark border-subtle text-muted">
                            Strona @currentPage z @totalPages
                        </span>
                    </li>
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link bg-dark border-subtle text-white" asp-action="All" asp-route-page="@(currentPage + 1)">
                            Następna <i class="bi bi-chevron-right ms-1"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>