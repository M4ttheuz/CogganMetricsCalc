@{
    ViewData["Title"] = "Import treningów FIT";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="mb-3">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Wróć do pulpitu
            </a>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex p-3 mb-2">
                        <i class="bi bi-cloud-arrow-up fs-2"></i>
                    </div>
                    <h4 class="fw-bold mb-1">Centrum Importu Treningów</h4>
                    <p class="text-muted small">Przeciągnij lub wskaż pliki <code>.fit</code> ze swojego licznika lub trenażera</p>
                </div>

                <div id="dropZone" class="upload-drop-zone border border-2 border-dashed rounded p-5 text-center bg-light mb-4" style="cursor: pointer; transition: all 0.2s ease;">
                    <i class="bi bi-file-earmark-arrow-up fs-1 text-muted"></i>
                    <h6 class="fw-bold mt-3 mb-1">Przeciągnij pliki tutaj</h6>
                    <p class="text-muted small mb-3">lub kliknij w dowolnym miejscu, aby wybrać z dysku (możesz zaznaczyć wiele)</p>
                    <button type="button" class="btn btn-sm btn-outline-primary fw-semibold">
                        Wybierz pliki
                    </button>
                    <input type="file" id="fileInput" multiple accept=".fit" class="d-none" />
                </div>

                <div id="fileListCard" class="card bg-light border-0 mb-4 is-hidden">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-semibold small text-dark"><i class="bi bi-list-check me-1"></i> Wybrane pliki (<span id="fileCount">0</span>)</span>
                            <button type="button" class="btn btn-link btn-sm text-danger text-decoration-none p-0" id="clearFilesBtn">Wyczyść listę</button>
                        </div>
                        <ul class="list-group list-group-flush small upload-file-list" id="fileList"></ul>
                    </div>
                </div>

                <div id="progressSection" class="mb-4 is-hidden">
                    <div class="d-flex justify-content-between small text-muted mb-1">
                        <span id="statusText">Przygotowywanie importu...</span>
                        <span id="percentText" class="fw-bold text-dark">0%</span>
                    </div>
                    <div class="progress upload-progress" style="height: 10px;">
                        <div id="uploadProgressBar" class="progress-bar progress-bar-striped progress-bar-animated bg-primary" role="progressbar" style="width: 0%"></div>
                    </div>
                </div>

                <div id="resultBox" class="mb-4 is-hidden"></div>

                <div>
                    <button type="button" id="startUploadBtn" class="btn btn-primary py-2 fw-semibold w-100" disabled>
                        <i class="bi bi-cpu me-1"></i> Rozpocznij import danych
                    </button>

                    <div id="postUploadActions" class="d-flex gap-2 is-hidden">
                        <button type="button" id="retryUploadBtn" class="btn btn-outline-secondary py-2 fw-semibold w-50">
                            <i class="bi bi-arrow-clockwise me-1"></i> Wgraj kolejne pliki
                        </button>
                        <a asp-action="Index" id="dashboardReturnBtn" class="btn btn-primary py-2 fw-semibold w-50 text-center">
                            Przejdź do pulpitu →
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('fileInput');
        const fileListCard = document.getElementById('fileListCard');
        const fileList = document.getElementById('fileList');
        const fileCount = document.getElementById('fileCount');
        const clearFilesBtn = document.getElementById('clearFilesBtn');
        const startUploadBtn = document.getElementById('startUploadBtn');
        const progressSection = document.getElementById('progressSection');
        const uploadProgressBar = document.getElementById('uploadProgressBar');
        const statusText = document.getElementById('statusText');
        const percentText = document.getElementById('percentText');
        const resultBox = document.getElementById('resultBox');
        const postUploadActions = document.getElementById('postUploadActions');
        const retryUploadBtn = document.getElementById('retryUploadBtn');

        const maxFileSizeBytes = 50 * 1024 * 1024;
        let selectedFiles = [];

        dropZone.addEventListener('click', (e) => {
            if (dropZone.classList.contains('is-disabled')) return;
            fileInput.click();
        });

        fileInput.addEventListener('click', (e) => {
            e.stopPropagation();
        });

        ['dragenter', 'dragover'].forEach(name => {
            dropZone.addEventListener(name, (e) => {
                e.preventDefault();
                if (dropZone.classList.contains('is-disabled')) return;
                dropZone.classList.add('is-dragging', 'border-primary', 'bg-white');
            });
        });

        ['dragleave', 'drop'].forEach(name => {
            dropZone.addEventListener(name, (e) => {
                e.preventDefault();
                dropZone.classList.remove('is-dragging', 'border-primary', 'bg-white');
            });
        });

        dropZone.addEventListener('drop', (e) => {
            if (dropZone.classList.contains('is-disabled')) return;
            const files = Array.from(e.dataTransfer.files).filter(f => f.name.toLowerCase().endsWith('.fit'));
            addFiles(files);
        });

        fileInput.addEventListener('change', (e) => {
            const files = Array.from(e.target.files).filter(f => f.name.toLowerCase().endsWith('.fit'));
            addFiles(files);
        });

        function addFiles(files) {
            const acceptedFiles = files.filter(file => file.size <= maxFileSizeBytes);
            const oversizedCount = files.length - acceptedFiles.length;
            selectedFiles = [...selectedFiles, ...acceptedFiles];
            renderFileList();

            if (oversizedCount > 0) {
                resultBox.innerHTML = `<div class="alert alert-warning border-0 shadow-sm p-3">Pominięto ${oversizedCount} plików większych niż 50 MiB.</div>`;
                resultBox.classList.remove('is-hidden');
            }
        }

        function renderFileList() {
            fileList.innerHTML = '';
            if (selectedFiles.length === 0) {
                fileListCard.classList.add('is-hidden');
                startUploadBtn.disabled = true;
                return;
            }

            fileListCard.classList.remove('is-hidden');
            startUploadBtn.disabled = false;
            fileCount.innerText = selectedFiles.length;

            selectedFiles.forEach((file, index) => {
                const li = document.createElement('li');
                li.id = `file-item-${index}`;
                li.className = 'list-group-item d-flex justify-content-between align-items-center bg-white px-2 py-1 mb-1 rounded border';
                li.innerHTML = `
                    <span class="text-truncate upload-file-name">
                        <i class="bi bi-file-earmark me-1 text-primary"></i>${file.name}
                    </span>
                    <span class="badge bg-light text-muted border file-status upload-file-status">Oczekuje</span>
                `;
                fileList.appendChild(li);
            });

            clearFilesBtn.classList.toggle('is-hidden', selectedFiles.length === 0);
        }

        function resetForm() {
            selectedFiles = [];
            fileInput.value = '';
            renderFileList();
            dropZone.classList.remove('is-disabled');
            dropZone.style.pointerEvents = 'auto';
            dropZone.style.opacity = '1';
            startUploadBtn.classList.remove('is-hidden');
            startUploadBtn.disabled = true;
            postUploadActions.classList.add('is-hidden');
            progressSection.classList.add('is-hidden');
            resultBox.classList.add('is-hidden');
        }

        clearFilesBtn.addEventListener('click', resetForm);
        retryUploadBtn.addEventListener('click', resetForm);

        startUploadBtn.addEventListener('click', async () => {
            if (selectedFiles.length === 0) return;

            startUploadBtn.disabled = true;
            dropZone.classList.add('is-disabled');
            dropZone.style.pointerEvents = 'none';
            dropZone.style.opacity = '0.6';
            clearFilesBtn.classList.add('is-hidden');
            progressSection.classList.remove('is-hidden');
            resultBox.classList.add('is-hidden');

            const token = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]').value;
            const total = selectedFiles.length;
            let successCount = 0;
            let skippedCount = 0;

            try {
                for (let i = 0; i < total; i++) {
                    const file = selectedFiles[i];
                    const itemElem = document.getElementById(`file-item-${i}`);
                    const statusBadge = itemElem ? itemElem.querySelector('.file-status') : null;

                    if (statusBadge) {
                        statusBadge.className = 'badge bg-primary upload-file-status';
                        statusBadge.innerText = 'Przetwarzanie...';
                    }

                    statusText.innerText = `Przetwarzanie: ${file.name} (${i + 1}/${total})`;
                    const currentPercent = Math.round((i / total) * 100);
                    uploadProgressBar.style.width = `${currentPercent}%`;
                    percentText.innerText = `${currentPercent}%`;

                    const formData = new FormData();
                    formData.append('file', file);

                    try {
                        const response = await fetch('/Activity/UploadSingleChunk', {
                            method: 'POST',
                            headers: { 'RequestVerificationToken': token },
                            body: formData
                        });

                        if (!response.ok) {
                            throw new Error(`Serwer zwrócił błąd HTTP: ${response.status}`);
                        }

                        const res = await response.json();
                        if (res.success) {
                            successCount++;
                            if (statusBadge) {
                                statusBadge.className = 'badge bg-success upload-file-status';
                                statusBadge.innerHTML = '<i class="bi bi-check2"></i> Gotowe';
                            }
                        } else {
                            skippedCount++;
                            if (statusBadge) {
                                statusBadge.className = 'badge bg-warning text-dark upload-file-status';
                                statusBadge.title = res.message || 'Pominięto';
                                statusBadge.innerHTML = '<i class="bi bi-exclamation-circle"></i> Pominięto';
                            }
                        }
                    } catch (e) {
                        skippedCount++;
                        if (statusBadge) {
                            statusBadge.className = 'badge bg-danger upload-file-status';
                            statusBadge.title = e.message;
                            statusBadge.innerText = 'Błąd';
                        }
                    }
                }

                uploadProgressBar.style.width = '100%';
                percentText.innerText = '100%';
                statusText.innerText = 'Aktualizacja wykresu formy (CTL / ATL / TSB)...';

                await fetch('/Activity/FinishBulkUpload', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token }
                });

                progressSection.classList.add('is-hidden');
                startUploadBtn.classList.add('is-hidden');
                postUploadActions.classList.remove('is-hidden');

                let alertType = skippedCount > 0 && successCount > 0 ? 'alert-warning' : (successCount > 0 ? 'alert-success' : 'alert-danger');
                resultBox.innerHTML = `
                    <div class="alert ${alertType} border-0 shadow-sm p-3">
                        <h6 class="fw-bold mb-1">Import zakończony!</h6>
                        <small>Zaimportowano poprawnie: <strong>${successCount}</strong>, pominięto/błędy: <strong>${skippedCount}</strong>.</small>
                    </div>
                `;
                resultBox.classList.remove('is-hidden');

            } catch (fatalError) {
                progressSection.classList.add('is-hidden');
                dropZone.classList.remove('is-disabled');
                dropZone.style.pointerEvents = 'auto';
                dropZone.style.opacity = '1';
                startUploadBtn.disabled = false;
                clearFilesBtn.classList.remove('is-hidden');

                resultBox.innerHTML = `
                    <div class="alert alert-danger border-0 shadow-sm p-3">
                        <h6 class="fw-bold mb-1"><i class="bi bi-exclamation-triangle-fill me-1"></i> Wystąpił błąd krytyczny</h6>
                        <small>${fatalError.message || 'Nie udało się nawiązać połączenia z serwerem'}. Możesz spróbować ponownie.</small>
                    </div>
                `;
                resultBox.classList.remove('is-hidden');
            }
        });
    </script>
}