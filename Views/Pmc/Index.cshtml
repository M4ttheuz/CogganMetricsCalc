@{
    ViewData["Title"] = "Wykres formy i zmęczenia";
}

<div class="container-fluid px-0 py-2">
    <!-- NAGŁÓWEK I WYBÓR ZAKRESU -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h4 class="fw-bold mb-1 text-white d-flex align-items-center">
                <i class="bi bi-graph-up-arrow text-info me-2"></i>Zarządzanie formą (PMC)
            </h4>
            <p class="text-muted small mb-0">Model impulsu-odpowiedzi (Banister / Coggan) – analiza przewlekłego i ostrego obciążenia</p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <div class="btn-group shadow-sm" id="pmcRangeButtons" role="group">
                <button type="button" class="btn btn-sm btn-outline-info fw-semibold px-3" data-days="30" onclick="loadPmc(30)">30 dni</button>
                <button type="button" class="btn btn-sm btn-outline-info fw-semibold px-3 active" data-days="90" id="btn90" onclick="loadPmc(90)">90 dni</button>
                <button type="button" class="btn btn-sm btn-outline-info fw-semibold px-3" data-days="180" onclick="loadPmc(180)">Pół roku</button>
                <button type="button" class="btn btn-sm btn-outline-info fw-semibold px-3" data-days="365" onclick="loadPmc(365)">Rok</button>
            </div>
        </div>
    </div>

    <!-- GÓRNE KAFELKI METRYK -->
    <div class="row g-3 mb-4" id="currentStatsRow">
        <!-- Forma (CTL) -->
        <div class="col-xl-3 col-sm-6">
            <div class="card h-100 p-3">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="metric-label">Forma (CTL)</div>
                        <h3 class="fw-bold mb-0 mt-1 text-info tabular-nums" id="statCtl">—</h3>
                    </div>
                    <div class="kpi-icon bg-info bg-opacity-10 text-info">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                </div>
                <div class="mt-3 text-muted small">Stała czasowa 42 dni (Fitness)</div>
            </div>
        </div>

        <!-- Zmęczenie (ATL) -->
        <div class="col-xl-3 col-sm-6">
            <div class="card h-100 p-3">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="metric-label">Zmęczenie (ATL)</div>
                        <h3 class="fw-bold mb-0 mt-1 text-danger tabular-nums" id="statAtl">—</h3>
                    </div>
                    <div class="kpi-icon bg-danger bg-opacity-10 text-danger">
                        <i class="bi bi-activity"></i>
                    </div>
                </div>
                <div class="mt-3 text-muted small">Stała czasowa 7 dni (Fatigue)</div>
            </div>
        </div>

        <!-- Świeżość (TSB) -->
        <div class="col-xl-3 col-sm-6">
            <div class="card h-100 p-3">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="metric-label">Świeżość (TSB)</div>
                        <h3 class="fw-bold mb-0 mt-1 tabular-nums" id="statTsb">—</h3>
                    </div>
                    <div class="kpi-icon bg-success bg-opacity-10 text-success">
                        <i class="bi bi-battery-charging"></i>
                    </div>
                </div>
                <div class="mt-3 small">
                    <span id="statTsbStatus" class="badge bg-secondary bg-opacity-25 text-light rounded-pill px-2 py-1">—</span>
                </div>
            </div>
        </div>

        <!-- Wymuszenie przeliczenia -->
        <div class="col-xl-3 col-sm-6">
            <div class="card h-100 p-3 d-flex flex-column justify-content-between">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="metric-label">Synchronizacja PMC</div>
                        <div class="text-muted small mt-1">Przelicz krzywe od początku historii</div>
                    </div>
                    <div class="kpi-icon bg-secondary bg-opacity-10 text-light">
                        <i class="bi bi-arrow-repeat"></i>
                    </div>
                </div>
                <button class="btn btn-sm btn-outline-light w-100 mt-3 fw-semibold py-2" id="btnManualRecalc" onclick="recalculatePmc()">
                    <i class="bi bi-cpu me-1"></i> Przelicz historię
                </button>
            </div>
        </div>
    </div>

    <!-- GŁÓWNY WYKRES PMC -->
    <div class="card">
        <div class="card-header py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span class="fw-bold text-white d-flex align-items-center">
                <i class="bi bi-sliders me-2 text-info"></i>Performance Management Chart
            </span>
            <div class="d-flex flex-wrap align-items-center gap-3 small text-muted">
                <span><i class="bi bi-circle-fill me-1" style="color: #38bdf8;"></i>CTL (Forma)</span>
                <span><i class="bi bi-circle-fill me-1" style="color: #fb7185;"></i>ATL (Zmęczenie)</span>
                <span><i class="bi bi-circle-fill me-1" style="color: #34d399;"></i>TSB (Balans)</span>
                <span><i class="bi bi-bar-chart-fill me-1 text-secondary"></i>TSS (Dobowy stres)</span>
            </div>
        </div>
        <div class="card-body p-3 p-md-4">
            <div class="chart-container chart-container--pmc">
                <canvas id="pmcChart"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        let pmcChartInstance = null;
        let currentDays = 90;

        // Globalne ustawienia Chart.js pod ciemny motyw
        Chart.defaults.color = '#94a3b8';
        Chart.defaults.borderColor = 'rgba(255, 255, 255, 0.06)';
        Chart.defaults.font.family = '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';

        function updateActiveButton(days) {
            currentDays = days;
            document.querySelectorAll('#pmcRangeButtons button').forEach(btn => {
                if (parseInt(btn.dataset.days) === days) {
                    btn.classList.add('active');
                } else {
                    btn.classList.remove('active');
                }
            });
        }

        async function loadPmc(days = 90) {
            updateActiveButton(days);

            const response = await fetch(`/Pmc/GetData?days=${days}`);
            if (!response.ok) return;

            const data = await response.json();
            if (data.length === 0) return;

            const last = data[data.length - 1];
            document.getElementById('statCtl').innerText = last.ctl;
            document.getElementById('statAtl').innerText = last.atl;

            const tsbEl = document.getElementById('statTsb');
            const tsbStatusEl = document.getElementById('statTsbStatus');
            tsbEl.innerText = (last.tsb > 0 ? "+" : "") + last.tsb;

            // Stylizacja statusu TSB dopasowana do ciemnego motywu
            if (last.tsb > 15) {
                tsbEl.className = "fw-bold mb-0 mt-1 tabular-nums text-info";
                tsbStatusEl.innerText = "Roztrenowanie / wysoka świeżość";
                tsbStatusEl.className = "badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 rounded-pill px-2 py-1";
            } else if (last.tsb >= -10 && last.tsb <= 15) {
                tsbEl.className = "fw-bold mb-0 mt-1 tabular-nums text-success";
                tsbStatusEl.innerText = "Optymalna strefa startowa";
                tsbStatusEl.className = "badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2 py-1";
            } else if (last.tsb >= -30 && last.tsb < -10) {
                tsbEl.className = "fw-bold mb-0 mt-1 tabular-nums text-warning";
                tsbStatusEl.innerText = "Produktywny blok treningowy";
                tsbStatusEl.className = "badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 rounded-pill px-2 py-1";
            } else {
                tsbEl.className = "fw-bold mb-0 mt-1 tabular-nums text-danger";
                tsbStatusEl.innerText = "Ryzyko przeciążenia (Overreaching)";
                tsbStatusEl.className = "badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-pill px-2 py-1";
            }

            const labels = data.map(d => d.date);
            const tssValues = data.map(d => d.tss > 0 ? d.tss : null);
            const ctlValues = data.map(d => d.ctl);
            const atlValues = data.map(d => d.atl);
            const tsbValues = data.map(d => d.tsb);

            const ctx = document.getElementById('pmcChart').getContext('2d');

            // Gradient pod krzywą CTL (Formy)
            const ctlGradient = ctx.createLinearGradient(0, 0, 0, 400);
            ctlGradient.addColorStop(0, 'rgba(56, 189, 248, 0.22)');
            ctlGradient.addColorStop(1, 'rgba(56, 189, 248, 0.0)');

            if (pmcChartInstance) {
                pmcChartInstance.destroy();
            }

            pmcChartInstance = new Chart(ctx, {
                data: {
                    labels: labels,
                    datasets: [
                        {
                            type: 'line',
                            label: 'Forma (CTL)',
                            data: ctlValues,
                            borderColor: '#38bdf8',
                            backgroundColor: ctlGradient,
                            fill: true,
                            borderWidth: 2.5,
                            pointRadius: 0,
                            pointHoverRadius: 5,
                            tension: 0.25,
                            yAxisID: 'yMetrics',
                            order: 1
                        },
                        {
                            type: 'line',
                            label: 'Zmęczenie (ATL)',
                            data: atlValues,
                            borderColor: '#fb7185',
                            borderWidth: 2,
                            pointRadius: 0,
                            pointHoverRadius: 5,
                            tension: 0.25,
                            yAxisID: 'yMetrics',
                            order: 2
                        },
                        {
                            type: 'line',
                            label: 'Świeżość (TSB)',
                            data: tsbValues,
                            borderColor: '#34d399',
                            backgroundColor: 'rgba(52, 211, 153, 0.07)',
                            borderDash: [4, 4],
                            borderWidth: 1.75,
                            pointRadius: 0,
                            pointHoverRadius: 5,
                            tension: 0.25,
                            yAxisID: 'yMetrics',
                            order: 3
                        },
                        {
                            type: 'bar',
                            label: 'TSS',
                            data: tssValues,
                            backgroundColor: 'rgba(148, 163, 184, 0.25)',
                            hoverBackgroundColor: 'rgba(56, 189, 248, 0.5)',
                            borderRadius: 3,
                            barPercentage: 0.55,
                            yAxisID: 'yTss',
                            order: 4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'index',
                        intersect: false
                    },
                    plugins: {
                        legend: {
                            display: false // Ukrywamy domyślną legendę, bo mamy własną, czystszą w nagłówku karty
                        },
                        tooltip: {
                            backgroundColor: 'rgba(15, 23, 42, 0.95)',
                            titleColor: '#f8fafc',
                            bodyColor: '#cbd5e1',
                            borderColor: 'rgba(255, 255, 255, 0.12)',
                            borderWidth: 1,
                            padding: 12,
                            cornerRadius: 8,
                            boxPadding: 6
                        }
                    },
                    scales: {
                        x: {
                            ticks: { maxTicksLimit: 12, color: '#64748b' },
                            grid: { display: false }
                        },
                        yMetrics: {
                            type: 'linear',
                            position: 'left',
                            title: { display: true, text: 'CTL / ATL / TSB', color: '#94a3b8', font: { size: 11, weight: '600' } },
                            grid: {
                                // Podświetlenie linii 0 (granica dodatniego i ujemnego TSB)
                                color: (context) => context.tick.value === 0 ? 'rgba(255, 255, 255, 0.25)' : 'rgba(255, 255, 255, 0.05)',
                                lineWidth: (context) => context.tick.value === 0 ? 1.5 : 1
                            }
                        },
                        yTss: {
                            type: 'linear',
                            position: 'right',
                            title: { display: true, text: 'Dobowy TSS', color: '#64748b', font: { size: 11, weight: '600' } },
                            beginAtZero: true,
                            suggestedMax: 300,
                            grid: { drawOnChartArea: false }
                        }
                    }
                }
            });
        }

        async function recalculatePmc() {
            const btn = document.getElementById('btnManualRecalc');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Przeliczanie...';
            }

            try {
                await fetch('/Pmc/Recalculate', { method: 'POST' });
                await loadPmc(currentDays);
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-cpu me-1"></i> Przelicz historię';
                }
            }
        }

        document.addEventListener("DOMContentLoaded", () => {
            loadPmc(90);
        });
    </script>
}